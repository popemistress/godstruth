generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  MODERATOR
  INSTRUCTOR
}

enum ContentType {
  VIDEO
  BOOK
  COURSE
  PODCAST
  GUIDE
}

enum Testament {
  OLD
  NEW
}

enum Plan {
  FREE
  SUPPORTER
  PARTNER
}

enum SubStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  TRIALING
  INCOMPLETE
}

// ─── Auth (NextAuth) ──────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed — null for OAuth users
  role          Role      @default(USER)

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  progress      UserProgress[]
  lessonProgress LessonProgress[]
  trackEnrollments TrackEnrollment[]
  quizAttempts  QuizAttempt[]
  cohortEnrollments CohortEnrollment[]
  cohortsLed    Cohort[] // as instructor
  liveRegistrations LiveSessionRegistration[]
  homeworkSubmissions HomeworkSubmission[]
  courseComments CourseComment[]
  certificates  Certificate[]
  churchMemberships ChurchGroupMember[]
  readingProgress UserReadingProgress[]
  memoryProgress UserMemoryProgress[]
  notes         UserNote[]
  highlights    UserHighlight[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Subscriptions ────────────────────────────────────────────────────────────

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  stripeCustomerId   String    @unique
  stripePriceId      String
  stripeSubscriptionId String  @unique
  status             SubStatus
  plan               Plan      @default(FREE)
  currentPeriodEnd   DateTime

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ─── Content ──────────────────────────────────────────────────────────────────

model Content {
  id          String      @id @default(cuid())
  type        ContentType
  title       String
  slug        String      @unique
  description String      @db.Text
  thumbnail   String?     // UploadThing URL
  mediaUrl    String?     // UploadThing URL (video/audio/PDF)
  duration    Int?        // seconds for video/audio
  published   Boolean     @default(false)
  premium     Boolean     @default(false)
  featured    Boolean     @default(false)
  order       Int         @default(0)

  bookId      String?
  book        Book?       @relation(fields: [bookId], references: [id])

  seriesId    String?
  series      Series?     @relation(fields: [seriesId], references: [id])

  tags        ContentTag[]
  progress    UserProgress[]
  chapters    CourseChapter[]
  tracks      CourseTrack[]
  cohorts     Cohort[]
  comments    CourseComment[]
  certificates Certificate[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([type, published])
  @@index([slug])
  @@index([bookId])
  @@index([seriesId])
}

model Series {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String      @db.Text
  thumbnail   String?
  type        ContentType
  order       Int         @default(0)

  content     Content[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Book {
  id        String    @id @default(cuid())
  name      String    @unique
  testament Testament
  order     Int
  slug      String    @unique

  content   Content[]
}

model Tag {
  id      String       @id @default(cuid())
  name    String       @unique
  slug    String       @unique
  content ContentTag[]
}

model ContentTag {
  contentId String
  tagId     String
  content   Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contentId, tagId])
}

// ─── User Progress ────────────────────────────────────────────────────────────

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  contentId   String
  progress    Float    @default(0)  // 0.0 – 1.0
  completed   Boolean  @default(false)

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content     Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)

  updatedAt   DateTime @updatedAt

  @@unique([userId, contentId])
  @@index([userId])
}

// ─── Course Chapters & Lessons ────────────────────────────────────────────────

model CourseChapter {
  id        String         @id @default(cuid())
  contentId String
  title     String
  order     Int            @default(0)
  content   Content        @relation(fields: [contentId], references: [id], onDelete: Cascade)
  lessons   CourseLesson[]

  createdAt DateTime @default(now())

  @@index([contentId])
}

model CourseLesson {
  id         String        @id @default(cuid())
  chapterId  String
  title      String
  type       String        @default("VIDEO")   // VIDEO, READING, QUIZ, ASSIGNMENT, IMAGE
  duration   Int?                               // seconds
  order      Int           @default(0)
  mediaUrl   String?                            // image / legacy video URL
  videoUrl   String?                            // embeddable video URL (YouTube, Vimeo, etc.)
  audioUrl   String?                            // podcast / audio file URL
  content    String?                            // rich text / markdown content
  coverUrl   String?                            // UploadThing header image URL
  published  Boolean       @default(true)
  chapter    CourseChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  trackDays  TrackDay[]
  comments   CourseComment[]
  progress   LessonProgress[]

  @@index([chapterId])
}

// ─── Bible Editions ───────────────────────────────────────────────────────────

model BibleEdition {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  translation   String   // KJV, NIV, NASB, NKJV, ESV, NLT, CSB, etc.
  publisher     String?
  publishedYear Int?
  description   String   @db.Text
  history       String   @db.Text
  coverUrl      String?  // UploadThing cover image URL
  fileUrl       String?  // UploadThing PDF URL
  filename      String?  // Original filename from bibles/ folder
  canonRating   Float    @default(9)
  canonNotes    String   @db.Text
  gradientFrom  String   @default("#1B2A4A")
  gradientTo    String   @default("#0D1525")
  accentColor   String   @default("#C9A84C")
  featured      Boolean  @default(false)
  order         Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([translation])
  @@index([slug])
}

// ─── Site Settings ────────────────────────────────────────────────────────────

model SiteSettings {
  id              String   @id @default("singleton")
  siteName        String   @default("Gods Truth")
  tagline         String   @default("Resources to help people understand God's Word")
  announcementBar String?
  announcementUrl String?
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}

// ─── Course Tracks (Guided Learning Paths) ────────────────────────────────────

model CourseTrack {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String    @db.Text
  courseId    String
  course      Content   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  order       Int       @default(0)
  days        TrackDay[]
  enrollments TrackEnrollment[]
  certificates Certificate[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([courseId])
  @@index([published])
}

model TrackDay {
  id                String        @id @default(cuid())
  trackId           String
  track             CourseTrack   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  dayNumber         Int
  title             String
  lessonId          String?
  lesson            CourseLesson? @relation(fields: [lessonId], references: [id])
  scriptureReading  String?       // e.g. "Genesis 1:1-31"
  prayerPrompt      String?       @db.Text
  hasQuiz           Boolean       @default(false)
  hasMentorCheckin  Boolean       @default(false)
  order             Int           @default(0)
  createdAt         DateTime      @default(now())

  @@unique([trackId, dayNumber])
  @@index([trackId])
}

model TrackEnrollment {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId         String
  track           CourseTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)
  currentDay      Int         @default(1)
  enrolledAt      DateTime    @default(now())
  completedAt     DateTime?
  mentorId        String?     // assigned mentor user id
  checkins        MentorCheckin[]

  @@unique([userId, trackId])
  @@index([userId])
  @@index([trackId])
}

model MentorCheckin {
  id                String          @id @default(cuid())
  enrollmentId      String
  enrollment        TrackEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  weekNumber        Int
  studentNotes      String?         @db.Text
  mentorNotes       String?         @db.Text
  prayerRequests    String?         @db.Text
  completedAt       DateTime?
  createdAt         DateTime        @default(now())

  @@unique([enrollmentId, weekNumber])
  @@index([enrollmentId])
}

// ─── Quizzes ──────────────────────────────────────────────────────────────────

model Quiz {
  id        String         @id @default(cuid())
  title     String
  lessonId  String?        // optional: tied to a specific lesson
  trackDayId String?       // optional: tied to a track day
  questions QuizQuestion[]
  attempts  QuizAttempt[]
  createdAt DateTime       @default(now())

  @@index([lessonId])
  @@index([trackDayId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question      String
  type          String   @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE, TRUE_FALSE
  options       Json     // ["Option A", "Option B", ...]
  correctAnswer String   // index as string "0", "1", etc.
  order         Int      @default(0)

  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers     Json     // { "0": "1", "1": "0", ... }
  score       Int      // number correct
  passed      Boolean  @default(false)
  attemptedAt DateTime @default(now())

  @@index([userId])
  @@index([quizId])
}

// ─── Cohorts ──────────────────────────────────────────────────────────────────

model Cohort {
  id           String            @id @default(cuid())
  title        String
  slug         String            @unique
  description  String?           @db.Text
  courseId     String
  course       Content           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   User              @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  startDate    DateTime
  endDate      DateTime?
  maxStudents  Int               @default(50)
  published    Boolean           @default(false)
  enrollments  CohortEnrollment[]
  liveSessions LiveSession[]
  assignments  HomeworkAssignment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([courseId])
  @@index([instructorId])
  @@index([published])
}

model CohortEnrollment {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cohortId  String
  cohort    Cohort    @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())
  status    String    @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED

  @@unique([userId, cohortId])
  @@index([userId])
  @@index([cohortId])
}

// ─── Live Sessions ──────────────────────────────────────────────────────────────

model LiveSession {
  id            String                   @id @default(cuid())
  cohortId      String
  cohort        Cohort                   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  title         String
  description   String?                  @db.Text
  scheduledAt   DateTime
  duration      Int                      @default(60) // minutes
  meetingUrl    String?
  maxAttendees  Int                      @default(100)
  registrations LiveSessionRegistration[]
  createdAt     DateTime                 @default(now())

  @@index([cohortId])
  @@index([scheduledAt])
}

model LiveSessionRegistration {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String
  session    LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  registeredAt DateTime  @default(now())
  attended   Boolean     @default(false)

  @@unique([userId, sessionId])
  @@index([userId])
  @@index([sessionId])
}

// ─── Homework ─────────────────────────────────────────────────────────────────

model HomeworkAssignment {
  id          String               @id @default(cuid())
  cohortId    String
  cohort      Cohort               @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  lessonId    String?
  title       String
  description String?              @db.Text
  dueDate     DateTime?
  maxPoints   Int                  @default(100)
  submissions HomeworkSubmission[]
  createdAt   DateTime             @default(now())

  @@index([cohortId])
}

model HomeworkSubmission {
  id            String            @id @default(cuid())
  assignmentId  String
  assignment    HomeworkAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  content       String?           @db.Text
  fileUrl       String?
  submittedAt   DateTime          @default(now())
  status        String            @default("SUBMITTED") // SUBMITTED, GRADED, RETURNED
  grade         HomeworkGrade?

  @@index([assignmentId])
  @@index([userId])
}

model HomeworkGrade {
  id           String             @id @default(cuid())
  submissionId String             @unique
  submission   HomeworkSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  points       Int
  feedback     String?            @db.Text
  gradedBy     String
  gradedAt     DateTime           @default(now())
}

// ─── Course Comments / Discussion ─────────────────────────────────────────────

model CourseComment {
  id        String    @id @default(cuid())
  courseId  String
  course    Content   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  String?
  lesson    CourseLesson? @relation(fields: [lessonId], references: [id])
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String    @db.Text
  parentId  String?
  parent    CourseComment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   CourseComment[] @relation("CommentReplies")
  approved  Boolean   @default(true)
  createdAt DateTime  @default(now())

  @@index([courseId])
  @@index([lessonId])
  @@index([userId])
  @@index([parentId])
}

// ─── Certificates ─────────────────────────────────────────────────────────────

model Certificate {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String?
  course             Content? @relation(fields: [courseId], references: [id])
  trackId            String?
  track              CourseTrack? @relation(fields: [trackId], references: [id])
  title              String
  certificateNumber  String   @unique
  issuedAt           DateTime @default(now())
  metadata           Json?    // template, signature, etc.

  @@index([userId])
  @@index([courseId])
  @@index([trackId])
}

// ─── Church / Ministry Groups ───────────────────────────────────────────────

model ChurchGroup {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  pastorName  String?
  email       String
  phone       String?
  address     String?
  logoUrl     String?
  plan        String            @default("FREE") // FREE, BASIC, PREMIUM
  maxMembers  Int               @default(50)
  members     ChurchGroupMember[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ChurchGroupMember {
  id        String      @id @default(cuid())
  groupId   String
  group     ChurchGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String      @default("MEMBER") // MEMBER, LEADER, ADMIN
  joinedAt  DateTime    @default(now())

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

// ─── Lesson-level Progress ────────────────────────────────────────────────────

model LessonProgress {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId          String
  lesson            CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  startedAt         DateTime?
  completedAt       DateTime?
  timeSpentSeconds  Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

// ─── Bible Study — Reading Plans ──────────────────────────────────────────────

model ReadingPlan {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String?           @db.Text
  duration    Int             // days
  coverImage  String?
  published   Boolean         @default(false)
  featured    Boolean         @default(false)
  days        ReadingPlanDay[]
  progress    UserReadingProgress[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ReadingPlanDay {
  id          String      @id @default(cuid())
  planId      String
  plan        ReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String?
  passages    String[]    // e.g. ["Genesis 1:1-31", "Psalm 1"]
  reflection  String?     @db.Text
  createdAt   DateTime    @default(now())

  @@unique([planId, dayNumber])
  @@index([planId])
}

model UserReadingProgress {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        ReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  currentDay  Int         @default(1)
  completedAt DateTime?
  updatedAt   DateTime    @updatedAt

  @@unique([userId, planId])
  @@index([userId])
  @@index([planId])
}

// ─── Bible Study — Devotionals ────────────────────────────────────────────────

model Devotional {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  scripture   String    // e.g. "John 3:16"
  body        String    @db.Text
  prayer      String?   @db.Text
  author      String?
  published   Boolean   @default(false)
  publishDate DateTime  @default(now())
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ─── Bible Study — Scripture Memorization ──────────────────────────────────────

model MemoryVerse {
  id          String    @id @default(cuid())
  reference   String    // e.g. "John 3:16"
  text        String    @db.Text
  translation String    @default("KJV")
  topic       String?   // e.g. "Love", "Faith"
  difficulty  String    @default("EASY") // EASY, MEDIUM, HARD
  published   Boolean   @default(false)
  collections MemoryCollectionItem[]
  userProgress UserMemoryProgress[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MemoryCollection {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?   @db.Text
  verses      MemoryCollectionItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MemoryCollectionItem {
  id           String            @id @default(cuid())
  collectionId String
  collection   MemoryCollection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  verseId      String
  verse        MemoryVerse       @relation(fields: [verseId], references: [id], onDelete: Cascade)
  order        Int               @default(0)

  @@unique([collectionId, verseId])
  @@index([collectionId])
}

model UserMemoryProgress {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  verseId       String
  verse         MemoryVerse @relation(fields: [verseId], references: [id], onDelete: Cascade)
  lastReviewed  DateTime?
  reviewCount   Int         @default(0)
  mastered      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, verseId])
  @@index([userId])
  @@index([verseId])
}

// ─── Bible Study — User Notes & Highlights ─────────────────────────────────────

model UserNote {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference   String    // e.g. "Genesis 1:1" or book-level
  content     String    @db.Text
  color       String    @default("yellow") // yellow, blue, green, pink, purple
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([reference])
}

model UserHighlight {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference   String    // e.g. "John 3:16"
  color       String    @default("yellow") // yellow, blue, green, pink, purple
  createdAt   DateTime  @default(now())

  @@unique([userId, reference])
  @@index([userId])
  @@index([reference])
}

// ─── Bible Study — Topics & Cross References ─────────────────────────────────

model TopicStudy {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  description String?   @db.Text
  passages    String[]  // list of verse references
  relatedTopics String[]
  published   Boolean   @default(false)
  featured    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model CrossReference {
  id          String    @id @default(cuid())
  sourceRef   String    // e.g. "John 3:16"
  targetRef   String    // e.g. "Romans 5:8"
  theme       String?   // e.g. "Love", "Redemption"
  createdAt   DateTime  @default(now())

  @@index([sourceRef])
  @@index([targetRef])
  @@index([theme])
}

// ─── Bible Study — Commentary Layers ───────────────────────────────────────────

model CommentaryEntry {
  id          String    @id @default(cuid())
  reference   String    // e.g. "Genesis 1:1"
  source      String    // e.g. "Matthew Henry", "Barnes Notes"
  body        String    @db.Text
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([reference])
  @@index([source])
}

// ─── Bible Study — Audio Bible ─────────────────────────────────────────────────

model BibleAudioEdition {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  reader      String?
  publisher   String?
  language    String    @default("en")
  coverImage  String?
  published   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
